# Python virtual environments (machine-specific, large)
.venv/
**/.venv/
venv/
env/

# Python caches / build
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp

# skill-creator eval/benchmark output (not skills)
*-workspace/

# Claude Code harness sync bucket (managed by the client, not a skill)
synced/

# Derived data caches (rebuilt from Postgres / Polygon; too large for git)
**/_pg_cache/
earnings-drift/data/

# Backup copies made before edits
*.bak
*.bak-*

# Persona memory folders hold personal data; backed up to D:\ nightly, never pushed (repo is public)
*/memory/
